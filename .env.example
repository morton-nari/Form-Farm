APP_ENV=development
DATABASE_URL=postgresql://form_farm:form_farm_local@127.0.0.1:5432/form_farm
DATABASE_ADMIN_URL=postgresql://form_farm:form_farm_local@127.0.0.1:5432/form_farm
DATABASE_POOL_MAX=10
ALLOW_DATABASE_SEED=false
PUBLIC_APP_ORIGIN=http://localhost:4200
AUTH_SECURE_COOKIES=false
TRUSTED_PROXY_HOPS=0
# Hosted preview/production must explicitly match APP_ENV for both markers.
# DATABASE_ENVIRONMENT=preview
# AUTH_SECRET_ENVIRONMENT=preview
# Development examples only. Production requires independent 32-byte base64url secrets.
XSRF_HMAC_SECRET=development-only-xsrf-secret-change-me
RATE_LIMIT_HMAC_SECRET=development-only-rate-secret-change-me
# When either previous secret is configured, set one future ISO timestamp no more than 24 hours ahead.
# XSRF_PREVIOUS_HMAC_SECRET=
# RATE_LIMIT_PREVIOUS_HMAC_SECRET=
# AUTH_PREVIOUS_SECRET_VALID_UNTIL=
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_TIMEOUT_MS=604800000
SESSION_ACTIVITY_CADENCE_MS=300000
XSRF_LIFETIME_MS=600000
REGISTRATION_RATE_LIMIT=5
LOGIN_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
