{
  "name": "form-farm-ai",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run domain:build",
    "start": "ng serve",
    "prebuild": "npm run domain:build",
    "build": "ng build",
    "prewatch": "npm run domain:build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run domain:build",
    "test": "ng test --watch=false",
    "backend:dev": "npm run dev --workspace @form-farm/backend",
    "backend:start": "npm run start --workspace @form-farm/backend",
    "backend:test": "npm run test --workspace @form-farm/backend",
    "backend:build": "npm run build --workspace @form-farm/backend",
    "predeployment:check": "npm run domain:build",
    "deployment:check": "tsc --project tsconfig.vercel.json --noEmit",
    "deployment:smoke": "node scripts/deployment/run-deployed-smoke.mjs",
    "deployment:smoke:test": "node --test scripts/deployment/*.test.mjs",
    "db:cleanup-smoke": "npm run db:cleanup-smoke --workspace @form-farm/backend",
    "db:migrate": "npm run db:migrate --workspace @form-farm/backend",
    "db:measure-pool": "npm run db:measure-pool --workspace @form-farm/backend",
    "db:rehearse-release": "npm run db:rehearse-release --workspace @form-farm/backend",
    "db:seed": "npm run db:seed --workspace @form-farm/backend",
    "domain:build": "npm run build --workspace @form-farm/form-domain",
    "test:all": "npm test && npm run backend:test",
    "build:all": "npm run build && npm run backend:build && npm run deployment:check"
  },
  "private": true,
  "workspaces": [
    "backend",
    "packages/*"
  ],
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.3 || >=24.15.0 <25 || >=26.0.0",
    "npm": ">=12"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "22.1.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
